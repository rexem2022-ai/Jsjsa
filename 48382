local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = obj
end

local function outline(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or C.line
    s.Thickness = thickness or 1
    s.Parent = obj
end

local function text(parent, value, size, bold, color)
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Text = value
    t.TextColor3 = color or C.white
    t.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    t.TextSize = size or 13
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextYAlignment = Enum.TextYAlignment.Center
    t.TextWrapped = true
    t.Parent = parent
    return t
end

local function button(parent, value, callback, width)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(width or 1, 0, 0, 32)
    b.BackgroundColor3 = C.panel2
    b.Text = value
    b.TextColor3 = C.white
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.AutoButtonColor = true
    b.Parent = parent
    corner(b, 7)
    outline(b)
    b.Activated:Connect(callback or function() end)
    return b
end

local function input(parent, placeholder, initial)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, 0, 0, 34)
    box.BackgroundColor3 = C.bg
    box.Text = initial or ""
    box.PlaceholderText = placeholder or ""
    box.PlaceholderColor3 = C.muted
    box.TextColor3 = C.white
    box.Font = Enum.Font.Gotham
    box.TextSize = 13
    box.ClearTextOnFocus = false
    box.Parent = parent
    corner(box, 7)
    outline(box)
    return box
end

local function section(parent, titleText)
    local holder = Instance.new("Frame")
    holder.BackgroundColor3 = C.panel
    holder.Size = UDim2.new(1, 0, 0, 10)
    holder.AutomaticSize = Enum.AutomaticSize.Y
    holder.Parent = parent
    corner(holder, 9)
    outline(holder)

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 10)
    pad.PaddingBottom = UDim.new(0, 10)
    pad.PaddingLeft = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)
    pad.Parent = holder

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 7)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = holder

    local heading = text(holder, titleText, 13, true, C.yellow)
    heading.Size = UDim2.new(1, 0, 0, 22)
    return holder
end

local function label(parent, value)
    local l = text(parent, value, 12, true, C.muted)
    l.Size = UDim2.new(1, 0, 0, 18)
    return l
end

